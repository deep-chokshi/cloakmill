{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "review_type": {"type": "string", "enum": ["code", "security"]},
    "reviewed_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"type": "string", "enum": ["completed", "incomplete"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "limitations": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "findings": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
          "confidence": {"type": "number", "minimum": 0.8, "maximum": 1},
          "title": {"type": "string", "minLength": 1, "maxLength": 180},
          "explanation": {"type": "string", "minLength": 1, "maxLength": 2000},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 1500},
          "recommendation": {"type": "string", "minLength": 1, "maxLength": 1500}
        },
        "required": ["path", "line", "severity", "confidence", "title", "explanation", "evidence", "recommendation"]
      }
    }
  },
  "required": ["review_type", "reviewed_head", "status", "summary", "limitations", "findings"]
}
